# Environment variables for neon-fox-relay
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/nostr_relay
DATABASE_MAX_CONNECTIONS=20

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Relay metadata
RELAY_NAME=neon-fox-relay
RELAY_DESCRIPTION=A high-performance Nostr relay
RELAY_PUBKEY=
RELAY_CONTACT=

# Logging (error, warn, info, debug, trace)
RUST_LOG=info

# Worker: Redis stream name for write queue
WRITE_STREAM_KEY=nostr:events:stream
WORKER_GROUP=nostr-workers
WORKER_CONSUMER=worker-1

# Limits
MAX_EVENT_TAGS=2000
MAX_CONTENT_LENGTH=65536
MAX_SUBSCRIPTIONS_PER_CLIENT=20
MAX_FILTERS_PER_SUBSCRIPTION=10
